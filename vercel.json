{
  "installCommand": "npm install --prefix client --no-fund --no-audit",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://engineering-day-2026.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://engineering-day-2026.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
